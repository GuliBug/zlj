{
  "name": "zhenglongji-mall-web",
  "version": "1.0.0",
  "private": true,
  "description": "正隆记槟榔商城 - Web 管理端（Vue3 + Element Plus，对齐 qingguoji-mall-web 依赖）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "vite build",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss,css,json}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.13.2",
    "element-plus": "2.13.1",
    "js-cookie": "3.0.5",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "vue": "3.5.26",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@vitejs/plugin-vue": "5.2.4",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "9.32.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "puppeteer": "^24.10.0",
    "sass": "1.83.0",
    "vite": "6.4.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "9.4.3"
  }
}
